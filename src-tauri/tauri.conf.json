{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Window Mirror",
  "version": "0.1.0",
  "identifier": "app.window-mirror",
  "build": {
    "frontendDist": "../packages/frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Window Mirror",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "center": true,
        "label": "main",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http: https: ws: wss:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 Window Mirror",
    "category": "DeveloperTool",
    "shortDescription": "Unified browser-IDE security workspace",
    "longDescription": "Window Mirror — A unified browser-IDE-pentest platform. The surveillance platform that happens to render HTML.",
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1", "libayatana-appindicator3-1", "librsvg2-common"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "store": {
      "autoSave": true,
      "filename": "window-mirror-store.dat"
    },
    "fs": {
      "scope": ["$APPDATA/**", "$HOME/**", "$TEMP/**", "$RESOURCE/**"]
    },
    "shell": {
      "scope": {
        "allow": [
          "cargo",
          "rustc",
          "node",
          "npm",
          "semgrep",
          "code"
        ]
      }
    }
  }
}